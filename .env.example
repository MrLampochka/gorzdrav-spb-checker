# Настройки почты
SMTP_HOST="smtp.mail.ru"
SMTP_PORT=465
SMTP_USER="me@mail.ru"
# для mail.ru / яндекса / гугла нужен пароль приложения, а не основной пароль
SMTP_PASSWORD="пароль приложения"
# адрес отправителя, по умолчанию равен SMTP_USER
# EMAIL_FROM="me@mail.ru"
# получатели через запятую
EMAIL_TO="me@mail.ru"
# true - ssl (порт 465), false - starttls (порт 587).
# Если не задано, определяется по порту
# SMTP_SSL=true

# Работа скрипта
# период проверки в секундах
CHECK_INTERVAL_SECS=300
# если задано, пауза между проверками случайная: от CHECK_INTERVAL_SECS до этого значения
# CHECK_INTERVAL_MAX_SECS=900
# сколько часов не повторять письмо про того же врача с теми же талонами
COOLDOWN_HOURS=6
# файлы, по умолчанию лежат рядом со скриптом
# WATCHES_FILE="watches.json"
# STATE_FILE="state.json"
# LOG_LEVEL=INFO

# Автозапись (для отслеживаний с "autoBook": true или "weekly")
# пациент должен быть прикреплён к медучреждению, иначе горздрав его не найдёт
# PATIENT_LAST_NAME="Иванов"
# PATIENT_FIRST_NAME="Иван"
# PATIENT_MIDDLE_NAME="Иванович"
# PATIENT_BIRTHDATE="01.01.1990"
# файл с записями бота
# BOOKINGS_FILE="bookings.json"

# Отмена по ссылке из письма (работает, пока скрипт запущен в режиме цикла)
# публичный адрес, по которому сервер виден снаружи (через nginx с https)
# CANCEL_URL="https://example.ru/gorzdrav"
# где слушает встроенный сервер
# CANCEL_LISTEN="127.0.0.1:8085"
