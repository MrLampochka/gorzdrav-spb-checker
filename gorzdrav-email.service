# Служба systemd: скрипт сам крутит цикл проверок.
# Установка:
#   sudo cp gorzdrav-email.service /etc/systemd/system/
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now gorzdrav-email
#   journalctl -u gorzdrav-email -f
# Путь к каталогу и пользователь ниже - поправить под свой сервер.

[Unit]
Description=Gorzdrav email checker
Documentation=https://gorzdrav.spb.ru
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=gorzdrav
Group=gorzdrav
WorkingDirectory=/opt/gorzdrav-email-checker
ExecStart=/usr/bin/python3 /opt/gorzdrav-email-checker/checker.py
# интервал проверок берется из CHECK_INTERVAL_SECS в .env
Restart=always
RestartSec=60
Environment=PYTHONUNBUFFERED=1

# каталог со скриптом должен быть доступен на запись: туда пишутся state.json и bookings.json
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/opt/gorzdrav-email-checker

[Install]
WantedBy=multi-user.target
